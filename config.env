# ============================================================================
#  img23d — tutti i parametri stanno qui.
#  Modifica questo file, non gli script.
#  Ogni valore si può sovrascrivere al volo:  RIG=1 ./generate.sh
# ============================================================================

# ---------------------------------------------------------------- generazione

# Passi di diffusion per la GEOMETRIA. Più alti = forma più pulita, più lento.
# Default del modello: 50. Con la tua GPU puoi alzare senza problemi.
SHAPE_STEPS=50

# Guidance scale della geometria: quanto la mesh aderisce all'immagine.
SHAPE_GUIDANCE=5.5

# Passi di diffusion per la TEXTURE (paint PBR).
TEXTURE_STEPS=30

# Rimuove lo sfondo dall'immagine prima di generare (consigliato: le foto con
# sfondo confondono la ricostruzione). 0 se le tue immagini sono gia' scontornate
# su fondo trasparente/bianco pulito.
REMOVE_BACKGROUND=1

# Risoluzione della texture in uscita (1024 o 2048). 2048 = più dettaglio, file
# più pesanti, un po' più lento.
TEXTURE_RESOLUTION=2048

# Formato del octree per l'estrazione della mesh: più alto = più poligoni e
# dettaglio geometrico. 256 default, 384/512 per massima qualità.
OCTREE_RESOLUTION=384

# ------------------------------------------------------------------- rigging

# Rigging automatico con UniRig: dalla mesh genera scheletro + skin weights.
#   0  niente rigging: esce solo il GLB texturizzato          (default)
#   1  esce anche <nome>_rigged.fbx
# NB: richiede l'immagine unirig, che setup.sh builda solo se RIG=1. Il suo
# build compila flash_attn/spconv: è la parte più fragile, vedi README.
RIG=0

# Rifinitura per Unreal: rinomina le ossa di UniRig coi nomi dello UE Mannequin
# (pelvis, spine_01, upperarm_l, thigh_r, ...) e aggiunge l'osso 'root' a terra.
# Serve perche' l'Auto Generate Retargeter di UE riconosce lo scheletro dai nomi.
# Esce model_rigged_ue.fbx accanto a model_rigged.fbx (grezzo). Solo con RIG=1.
#   1 = on (default), 0 = tiene solo l'FBX grezzo con nomi bone_N
RIG_UE_NAMES=1

# Se dopo il retarget in UE le animazioni escono SPECCHIATE (destra<->sinistra),
# metti 1: scambia i suffissi _l/_r.
RIG_FLIP_LR=0

# ------------------------------------------------------------------- texture

# Esporta le mappe texture in PNG separati nella cartella di output, da collegare
# a mano in UE5: model_albedo.png, model_roughness.png, model_metallic.png e
# model_orm.png (la mappa impaccata intera: G=roughness, B=metallic).
#   1 = on (default), 0 = off (la texture resta comunque dentro model.glb)
EXPORT_TEXTURES=1

# ---- stile PS2 (opzionale, non tocca gli output normali) ----
# PS2_TEXTURE=1 crea anche model_albedo_ps2.png: texture piccola con filtro
# nearest (pixelato secco) e palette ridotta, per il look retro. Il modello
# low-poly lo ottieni con POST_DECIMATE_FACES qui sopra (es. 5000).
PS2_TEXTURE=0
PS2_TEXTURE_SIZE=256     # 128 / 256 / 512
PS2_POSTERIZE=5          # livelli di colore (bit): 0=off, 4-5 = bel look retro

# ------------------------------------------------------------ post-processing

# Alleggerimento: riduce i poligoni mantenendo texture e UV originali. Utile per
# il realtime (motori di gioco). 0 = off. Esce model_light.glb accanto al pieno.
POST_DECIMATE_FACES=0

# Retopology a QUAD (quadriflow) + UV nuove + ribake del base color. E' quello
# che fanno i siti a pagamento per avere mesh pulite e animabili. Esce
# model_retopo.glb SENZA toccare l'originale. Piu' fragile del decimate.
#   0 = off, 1 = on
POST_QUAD_REMESH=0
POST_QUAD_FACES=20000        # target di facce del quad remesh

# Esporta il modello texturizzato anche in altri formati, per la tua pipeline.
# Lista separata da virgole: glb (sempre), fbx, obj, usdc
EXPORT_FORMATS=glb

# ------------------------------------------------------------------- preview

# Video turntable del modello (giro di 360°) per vederlo senza aprire niente.
PREVIEW=1
PREVIEW_FORMAT=mp4        # mp4 | gif
PREVIEW_FRAMES=48         # fotogrammi del giro completo

# ------------------------------------------------------------------ percorsi

IMAGES_DIR=./images
OUTPUT_DIR=./output
CKPTS_DIR=./ckpts

# ------------------------------------------------------------------- docker

IMAGE_TAG=img23d:latest
UNIRIG_TAG=img23d-unirig:latest

SHM_SIZE=16g

# DEV=1 monta gli script dall'host sopra quelli dell'immagine: modifichi un
# .py e rilanci senza ribuildare.
DEV=0
